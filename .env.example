# ──────────────────────────────────────────────
# bookSys — Environment Variables
# Copy to .env and fill in values
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://booksys:booksys_dev_pass@localhost:5432/booksys?schema=public

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Application ───────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Authentication ────────────────────────────
JWT_SECRET=change-this-to-a-random-string-at-least-32-characters
JWT_EXPIRY=24h

# ── Ticket QR Signing ────────────────────────
TICKET_SIGNING_SECRET=change-this-to-a-random-string-at-least-32-characters

# ── Payment Gateway ──────────────────────────
# Options: mock, sandbox
# 'mock' uses built-in simulator (blocked in production)
# 'sandbox' uses real payment gateway sandbox
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=mock-webhook-secret-dev

# For real sandbox (when available):
# SANDBOX_MERCHANT_ID=
# SANDBOX_API_KEY=
# SANDBOX_SECRET_KEY=
# SANDBOX_WEBHOOK_SECRET=
# SANDBOX_BASE_URL=

# ── Email (SMTP) ─────────────────────────────
# In development, emails are logged to console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@booksys.local

# ── Booking Configuration ────────────────────
HOLD_DURATION_MINUTES=10
PAYMENT_TIMEOUT_MINUTES=15

# ── Waiting Room ─────────────────────────────
WAITING_ROOM_THRESHOLD=100

# ── Frontend ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
