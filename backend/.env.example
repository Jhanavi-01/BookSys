# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_booking?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Auth
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Seat Holds
SEAT_HOLD_DURATION_MINUTES=10
PAYMENT_TIMEOUT_MINUTES=15

# QR / Ticket Signing
TICKET_SIGNING_SECRET=your-hmac-signing-secret-change-in-production

# Payment Provider: mock | sandbox | production
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@ticketbooking.vn
EMAIL_FROM_NAME=Ticket Booking VN

# Waiting Room
WAITING_ROOM_MAX_CONCURRENT=100
WAITING_ROOM_PASS_DURATION_SECONDS=300

# Uploads
MAX_SEAT_MAP_SIZE_MB=5

# Logging
LOG_LEVEL=debug

# CORS
CORS_CREDENTIALS=true
